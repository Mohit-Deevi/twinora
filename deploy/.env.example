# Jarvis server deployment — copy to .env and fill in. NEVER commit .env.
#
#   cp .env.example .env && nano .env
#   docker compose up -d --build

# ============================================================================
# REQUIRED
# ============================================================================

# Public hostname. Must already point at this server's public IP (A/AAAA record)
# before you start the stack, or Let's Encrypt cannot issue a certificate.
JARVIS_DOMAIN=jarvis.growstack.ai
ACME_EMAIL=tech@growstack.ai

# The brain. Use a real Anthropic API key on a server — OAuth/Max is tied to a personal
# login and needs interactive refresh, which will break unattended.
# Get one at https://console.anthropic.com  ->  API keys
ANTHROPIC_API_KEY=sk-ant-...

# Bearer token your applications send. This grants FULL Hermes access including terminal
# commands — treat it like a root password. Generate a strong one:
#   openssl rand -hex 32
API_SERVER_KEY=

# Path to a checkout of the Hermes source (the image is built from its Dockerfile):
#   git clone https://github.com/NousResearch/hermes-agent
HERMES_SRC=./hermes-agent

# ============================================================================
# OPTIONAL
# ============================================================================

# Name your app sends as "model". Defaults to "jarvis".
API_SERVER_MODEL_NAME=jarvis

# Only needed if a BROWSER calls the API directly. Prefer calling from your backend and
# leaving this empty — a browser caller means shipping the key to end users.
API_SERVER_CORS_ORIGINS=

# Host user that owns the data volume (keeps file permissions sane):  id -u ; id -g
HERMES_UID=1000
HERMES_GID=1000

# Resource ceiling for the gateway container.
HERMES_CPUS=4
HERMES_MEMORY=6g

# ---- integrations (blank is fine) ------------------------------------------
GROWSTACK_ROUTER_KEY=
INSTANTLY_API_KEY=
APOLLO_API_KEY=
FAL_KEY=
HF_TOKEN=

# ---- messaging: off by default on a server. Turn on deliberately. ----------
# WhatsApp needs an interactive QR pairing, which is awkward headless — prefer Telegram
# on a server, or pair locally and copy ~/.hermes/whatsapp/session into the volume.
WHATSAPP_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USERS=
